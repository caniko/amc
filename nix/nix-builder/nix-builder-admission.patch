@@ -496,5 +506,18 @@ void Worker::waitForInput()
             });
 
+#ifdef __linux__
+        if (getDaemonBuildPolicy() && j->inBuildSlot && j->respectTimeouts
+            && goal->jobCategory() == JobCategory::Build && goal->exitCode == Goal::ecBusy) {
+            auto & policy = *getDaemonBuildPolicy();
+            double full = buildPolicyFullPsi(*getDaemonBuildCgroup() / "memory.pressure");
+            if (j->buildPressure.exceeded(after, full, policy)) {
+                warn("cancelling %s: builder full memory PSI %.2f%% persisted for %d seconds",
+                    goal->getName(), full, policy.pressureSeconds);
+                goal->timedOut(TimedOut(policy.pressureSeconds));
+                continue;
+            }
+        }
+#endif
         if (goal->exitCode == Goal::ecBusy && 0 != settings.maxSilentTime && j->respectTimeouts
             && after - j->lastOutput >= std::chrono::seconds(settings.maxSilentTime)) {
             goal->timedOut(TimedOut(settings.maxSilentTime));
