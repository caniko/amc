+/*
+ * Guard the exact mm served by /proc/PID/amc_mem, before admission. Pin its
+ * target memcg and ancestry against removal/controller reconfiguration, and
+ * serialize acquisition with cgroup migration. The fallback cannot follow a
+ * dying mm owner to an already-existing CLONE_VM peer in another memcg.
+ */
+int mem_cgroup_amc_pin(struct mm_struct *mm, struct task_struct *task)
+{
+	static atomic64_t next_cookie = ATOMIC64_INIT(0);
+	struct mem_cgroup *memcg, *pinned;
+	struct cgroup *cgrp;
+	int ret = -ESRCH;
+
+	if (mem_cgroup_disabled())
+		return -EOPNOTSUPP;
+	cgroup_lock();
+	task_lock(task);
+	if (task->mm != mm)
+		goto out;
+	memcg = mem_cgroup_from_task(task);
+	if (!memcg || !cgroup_on_dfl(memcg->css.cgroup)) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	pinned = rcu_dereference_protected(mm->amc_recovery_memcg,
+					   lockdep_is_held(&cgroup_mutex));
+	if (pinned && pinned != memcg) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (mm->amc_recovery_refs == UINT_MAX) {
+		ret = -EOVERFLOW;
+		goto out;
+	}
+	if (!pinned) {
+		for (cgrp = memcg->css.cgroup; cgrp; cgrp = cgroup_parent(cgrp)) {
+			if (cgrp->amc_recovery_pins == UINT_MAX) {
+				ret = -EOVERFLOW;
+				goto out;
+			}
+		}
+		if (!css_tryget_online(&memcg->css))
+			goto out;
+		for (cgrp = memcg->css.cgroup; cgrp; cgrp = cgroup_parent(cgrp))
+			cgrp->amc_recovery_pins++;
+		mm->amc_recovery_cookie = atomic64_inc_return(&next_cookie);
+		rcu_assign_pointer(mm->amc_recovery_memcg, memcg);
+	}
+	mm->amc_recovery_refs++;
+	ret = 0;
+out:
+	task_unlock(task);
+	cgroup_unlock();
+	return ret;
+}
+
+void mem_cgroup_amc_unpin(struct mm_struct *mm)
+{
+	struct mem_cgroup *memcg = NULL;
+	struct cgroup *cgrp;
+
+	cgroup_lock();
+	if (!--mm->amc_recovery_refs) {
+		memcg = rcu_dereference_protected(mm->amc_recovery_memcg,
+						lockdep_is_held(&cgroup_mutex));
+		rcu_assign_pointer(mm->amc_recovery_memcg, NULL);
+		for (cgrp = memcg->css.cgroup; cgrp; cgrp = cgroup_parent(cgrp))
+			cgrp->amc_recovery_pins--;
+	}
+	cgroup_unlock();
+	if (memcg) {
+		synchronize_rcu();
+		css_put(&memcg->css);
+	}
+}
+
+static int mem_cgroup_amc_can_attach(struct cgroup_taskset *tset)
+{
+	struct task_struct *task;
+	struct cgroup_subsys_state *css;
+	bool guarded;
+
+	cgroup_taskset_for_each(task, css, tset) {
+		task_lock(task);
+		guarded = task->mm && task->mm->amc_recovery_refs;
+		task_unlock(task);
+		if (guarded)
+			return -EBUSY;
+	}
+	return 0;
+}
 
