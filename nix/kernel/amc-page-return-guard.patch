+#ifdef CONFIG_MEMCG
+/* Root-only, read-only proc-mem descriptor with an FD-owned memcg guard. */
+static int amc_mem_open(struct inode *inode, struct file *file)
+{
+	struct task_struct *task;
+	struct mm_struct *mm;
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	ret = mem_open(inode, file);
+	if (ret)
+		return ret;
+	mm = file->private_data;
+	ret = -ESRCH;
+	if (!mm)
+		return ret;
+	if (!mmget_not_zero(mm))
+		goto out_drop;
+	task = get_proc_task(inode);
+	if (task) {
+		ret = mem_cgroup_amc_pin(mm, task);
+		put_task_struct(task);
+	}
+	mmput(mm);
+	if (!ret)
+		return 0;
+out_drop:
+	mmdrop(mm);
+	file->private_data = NULL;
+	return ret;
+}
+
+static int amc_mem_release(struct inode *inode, struct file *file)
+{
+	mem_cgroup_amc_unpin(file->private_data);
+	return mem_release(inode, file);
+}
+
+static void amc_mem_fdinfo(struct seq_file *seq, struct file *file)
+{
+	struct mm_struct *mm = file->private_data;
+	struct mem_cgroup *memcg;
+
+	cgroup_lock();
+	memcg = rcu_dereference_protected(mm->amc_recovery_memcg,
+					lockdep_is_held(&cgroup_mutex));
+	seq_printf(seq, "amc_guard_version:\t1\namc_guard_cookie:\t%llu\n"
+		   "amc_guard_memcg_ino:\t%lu\n", mm->amc_recovery_cookie,
+		   (unsigned long)cgroup_ino(memcg->css.cgroup));
+	cgroup_unlock();
+}
+
